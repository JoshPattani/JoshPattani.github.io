# This repository is a plain static GitHub Pages site.
# The browser does not read this file directly. Use these names for local notes,
# optional CI injection, and Supabase Edge Function secrets.

# Public browser config. Safe to expose.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-or-anon-key>
VITE_ANALYTICS_ENDPOINT=https://<project-ref>.functions.supabase.co/track-visit
VITE_ANALYTICS_SITE_ID=portfolio
VITE_ENABLE_ANALYTICS=false
VITE_TRACK_LOCALHOST=false

# Edge Function secrets. Never expose in browser code.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ALLOWED_ORIGINS=https://www.jpattani.me,https://jpattani.me,https://joshpattani.github.io,http://localhost:8000,http://127.0.0.1:8000
ANALYTICS_SITE_ID=portfolio
RATE_LIMIT_SALT=<random-long-secret>
